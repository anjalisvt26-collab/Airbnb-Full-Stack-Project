
<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-8 offset-2"></div>
   
    <br/>
    <h3>Edit your listing</h3>
    <br/><br/>

    <form  method ="POST" action="/listings/<%= listing._id %>?_method=PUT"> 
        
        <div class="mb-3">
            <label for="title" class="for-label"> Title </label>
               <input name ="listing[title]"  value= "<%= listing.title %>"  type = "text" class="form-control">
       
        </div>    
        
        <div class="mb-3">
     <label for="description" class="for-label"> Description </label>
      <textarea name="listing[description]" class="form-control"><%= listing.description %></textarea>
    
        </div>

      
        <div class="mb-3">
               <label for="image" class="for-label"> Image Link </label>
              <input name ="listing[image]"  value= "<%= listing.image %>" type = "text" class="form-control">

        </div>

        <div class="row">
            <div class="mb-3 col-md-4">
             <label for="price" class="for-label"> Price </label>
              <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control">
        </div>     

        <div class="mb-3 col-md-8">
         <label for="country" class="for-label">Country</label>
          <input name ="listing[location]"  value= "<%= listing.country %>" type = "text" class="form-control">
       </div> 

        </div>

        <div>
         <label for="location" class="for-label"> Location </label>
         <input name ="listing[country]"  value= "<%= listing.location %>" type = "text" class="form-control">
             </div>         
             <br/>            
      
         <br/>
        <button class="btn btn-dark edit-btn">Edit</button>
        <br/><br/>


    </form>
    </div>
    </div>
